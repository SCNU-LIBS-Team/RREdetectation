  var nb = ' ';
  var pad_left, pad_right;
  var left;
  var col1 = 0;

  max_length = max_length + 1;  // pad space on end
  max_right_length = max_right_length +1;
  var delim = '|';
  // below the argument to new Array (e.g. pad_right) is increased by 1 because the technique to use new Array and join to repeat the "nb" character will result in one less than is desired

  //if (max_length == 21 ) {  // Ritz wavelength column
  if (header < 0 ) {  // Ritz wavelength column
    col1 = 1;
    if (header == -2 ) {
      header = 1;
    } else {
      if ( max_left_length + max_right_length + 1 < max_length ) {
        var add_left = Math.floor((max_length - 1)/2);
        max_left_length = add_left;
        max_right_length = max_length - 1 - max_left_length;
      }
    }
    //console.log("header="+header+ ", max_length=" +max_length + ", max_left_length="+max_left_length+", max_right_length=" + max_right_length);
  }

  if (header == 1) {
    pad_right = max_length - value.toString().length;  // add a space at the end
    if (pad_right < 0) {
      pad_right = 0; // mismatch - incoming header is longer than expected.  Not expected (error)
    }
    result = value.toString() + new Array (pad_right+1).join(nb) + delim;
    return (result);
  }


  if (col1 == 1) {
    if (value.toString().match(/\./) == null) {
// TODO - fix
      value = value + ".00";
    }
    parts = value.toString().split(".");
    pad_left = max_left_length - parts[0].length;  // determine how much padding to tack onto the beginning
    if ( pad_left < -1 ) {
      pad_left = -1;
    }
    pad_right = max_right_length - parts[1].length;  // determine how much padding to tack onto the beginning
    if ( pad_right < -1 ) {
      pad_right = -1;
    }
    left = new Array (pad_left+1).join(nb) + parts[0];
    result = left + "." + parts[1] + new Array ( pad_right +1).join(nb) + delim;
  }
  else if (value.toString().length == 0) {
     //HEREresult = new Array(max_length+1).join(nb) + max_length + delim;  // all spaces
    result = new Array(max_length+1).join(nb) + delim;  // all spaces
  }
  else {
