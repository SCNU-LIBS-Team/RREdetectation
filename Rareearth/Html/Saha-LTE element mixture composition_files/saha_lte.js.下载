function mergeGrids(gridExp,gridCalc,minWL,maxWL,skipFirst) {
  var grid = [];
  var wlHash = {};
  if ( gridExp != null ) {
    for ( var i in gridExp ) {
      if ( (gridExp[i][0] >= minWL) && (gridExp[i][0] <= maxWL) && (wlHash[gridExp[i][0]] == null) ) {
        grid.push(gridExp[i][0]);
        wlHash[gridExp[i][0]] = 1;
        //console.log("newExpWL="+gridExp[i][0]);
      }
    }
  }
  //console.log("gridCalc.length="+gridCalc.length+", gridCalc[0][0]=" + gridCalc[0][0]);
  //console.log("gridExp.length="+gridExp.length+", gridExp[0][0]=" + gridExp[0][0]);
  for ( var i in gridCalc ) {
    if ( skipFirst && (i == 0) ) {
      continue;
    }
    if ( (gridCalc[i][0] - minWL >=0) && (gridCalc[i][0] - maxWL <=0) && (wlHash[gridCalc[i][0]] == null) ) {
      grid.push(gridCalc[i][0]);
