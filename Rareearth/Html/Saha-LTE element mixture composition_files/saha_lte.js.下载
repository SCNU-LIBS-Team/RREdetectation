function checkSubmit(e) {
  var tempBox = document.getElementById("temp");
  if ( tempBox.value <= 0 ) {
    alert("Electron temperature must be greater than zero.");
    tempBox.focus();
    return false;;
  }
  var edenBox = document.getElementById("eden");
  if ( edenBox.value <= 0 ) {
    alert("Electron density must be greater than zero.");
    edenBox.focus();
    return false;;
  }
  var percBoxes = document.getElementsByName("perc");
  var numElem = percBoxes.length;
  var sum = 0;
  var validSum = 0;
  var firstInvalid = -1;
  var newComp = "";
  for ( var i = 0; i < numElem; i++) {
    var elName = document.getElementById("elem" + (i+1)).innerHTML;
    newComp += (newComp ? ";" : "") + elName + ":" + percBoxes[i].value;
    sum += (percBoxes[i].value - 0);
    if ( ((sum > 100) || (percBoxes[i].value - 0 < 0) || (sum < 100 && i == numElem - 1)) && (firstInvalid < 0) ) {
      firstInvalid = i;
    } else {
      validSum = sum;
    }
  }
  if ( sum != 100 ) {
    alert("Sum of percentages must be equal to 100. Current value: " + sum);
    if ( firstInvalid < 0 ) {
      firstInvalid = numElem - 1;
    }
    var newPerc = numElem == 1 ? 100 : (100 - validSum)/(numElem - firstInvalid);
    if ( newPerc < 0 ) {
      newPerc = "";
    }
    //console.log("numElem=" + numElem +", validSum="+validSum+", firstInvalid="+firstInvalid+", newPerc="+newPerc);
    for ( var i = firstInvalid; i < numElem; i++ ) {
      percBoxes[i].value = ( (newPerc == "") && (i == 0) ) ? "100" : newPerc;
    }
    percBoxes[firstInvalid].focus();
    return false;
  }
  composition = newComp;
  temp = tempBox.value - 0;
  eden = edenBox.value - 0;
  var resBox = document.getElementById("resolution");
  if ( resBox != null ) {
    resolution = resBox.value - 0;
    if ( resolution < 100 ) {
      //var chk = document.getElementById("draw_sticks_box");
      //chk.checked = true;
      //stickPlot = true;
      alert("Resolution must be >=100. \nTo show a stick plot, use the check box below the graph.");
      resBox.focus();
      return false;
    }
  }

  drawUserData();
  return false;
}  // checkSubmit
function setSelect(data,hiddenCols) {
  var sel=document.getElementById("select_columns");
  sel.size = data.getNumberOfColumns() - 1;
//  sel.size = 4;  // Hard code size=""  for "select_columns" select box with id="select_columns" to 4
  sel.innerHTML = "";
  var numSelected = 0;
  for (var i=1;i<=sel.size;i++) {
    var option = document.createElement("option");
    option.value = i;
    option.text = data.getColumnLabel(i).split(/[(]/)[0];
    var selected = true;
    numSelected++;
    for ( var j in hiddenCols ) {
      if ( option.text == hiddenCols[j] ) {
        selected = false;
        numSelected--;
        break;
      }
    }
    option.selected = selected;
    sel.appendChild(option);
  }
  if ( numSelected == 0 ) {
    sel.options[0].selected = true;
  }
}
