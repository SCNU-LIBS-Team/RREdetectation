function saha(temp,eden,cmeV,koeff,z,spectra,levels,gValues,ips) {
  var sahaIon = {};
  var rw = koeff*temp*Math.sqrt(temp)/eden;
  // Sum scaled level populations
  var sumPop = {};
  //var prevIon = 1;
  var prevIon = 0;
  var prevIonG = 1;
  var prevIP = 0;
  var cnt_tot = 0;
  var maxAbund = 0;
  for ( var sc in spectra[z] ) {
    var pf = 0;
    sumPop[sc] = 0;
    var cnt = 0;
    for ( var i = 0; i < levels[z][sc].length; i++ ) {
      var dp = Math.exp(-levels[z][sc][i]/(temp*cmeV))*gValues[z][sc][i];
      //if ( (dp + 0) != dp ) {
        //console.log("saha sc="+sc+ ", dp=" +dp + ", temp="+temp+", cmeV=" + cmeV + ", g=" +gValues[z][sc][i]+", exp=" + (-levels[z][sc][i]/(temp*cmeV)) );
      //}
      pf += dp;
      cnt++;
    }
    //console.log("Partition function="+sum);
    //var mult = rw*prevIon/prevIonG*Math.exp(-prevIP/(temp*cmeV));
    var logAbund = Math.log(rw*pf/prevIonG) - prevIP/(temp*cmeV) + prevIon;
    //if ( (mult + 0) != mult ) {
      //console.log("saha sc="+sc + ", rw="+rw+", prevIon="+prevIon+", prevIonG="+prevIonG+", prevIP=" +prevIP+", exp="+(-prevIP/(temp*cmeV)) );
    //}
    if ( logAbund > maxAbund ) {
      maxAbund = logAbund;
    }
    sahaIon[sc] = [logAbund, pf];
    prevIon = logAbund;
    prevIonG = pf;
    prevIP = ips[z][sc];
    //console.log("saha sc="+sc + ", sum="+sum+ ", cnt="+cnt+", pop=" + sahaIon[sc][0]);
    //console.log("z="+z);
    if ( Math.floor(z) == sc ) {
      // Add partition function for bare nucleus
      logAbund = Math.log(rw/prevIonG) - prevIP/(temp*cmeV) + prevIon;
      sahaIon[sc+1] = [logAbund,1];
    }
  }
  //renormalize the ion populations
  var total = 0;
  for ( var sc in sahaIon ) {
    if (sahaIon.hasOwnProperty(sc)) {
      sahaIon[sc][0] -= maxAbund;
      total += Math.exp(sahaIon[sc][0]);
      if (!isFinite(total)) {
        alert("Numerical overflow in calculation of ionization balance.\nTry lower temperatures.");
      }
    }
  }
  total = Math.log(total);
  //console.log("saha total="+total);
  for ( var sc in sahaIon ) {
    if (sahaIon.hasOwnProperty(sc)) {
      sahaIon[sc][0] = Math.exp(sahaIon[sc][0] - total);
      //console.log("saha z="+z+", sc="+sc + ", sum="+sum+ ", cnt="+cnt+", pop=" + sahaIon[sc][0]);
    }
  }
  return sahaIon;
}
