function indBelow(grid,wlTarget,wlMax) {
  var last = grid.length - 1;
  var first = 0;
  var minWL = grid[0];
  var maxWL = grid[last];
  if ( (wlMax < minWL) || (wlTarget > maxWL) ) {
    return -1;
  }
  if ( wlTarget <= minWL ) {
    return 0;
  }
  if ( wlTarget >= maxWL ) {
    return last;
  }
  //console.log("\nindBelow0: wlTarget,wlMax="+wlTarget+","+wlMax);
  while (last - first > 1) {
    var i = first + parseInt((last - first)/2);
    var diff = grid[i] - wlTarget;
    if ( diff < 0 ) {
      first = i;
    } else {
      last = i;
    }
    //console.log("indBelow1: i,diff,first,last="+i+","+diff+","+first+","+last);
  }
  var diff1 = grid[first] - wlTarget;
  var diff2 = grid[last] - wlTarget;
  //console.log("indBelow2: diff1,diff2,first,last="+diff1+","+diff2+","+first+","+last);
  if ( diff2 <= 0 ) {
    return last;
  } else if (diff1 <= 0) {
    return first;
  } else {
    while ( (diff1 > 0) && (first > 0) ) {
      first--;
      diff1 = grid[first] - wlTarget;
    }
    //console.log("indBelow3: diff1,first="+diff1+","+first);
    return first;
  }
}
