function arrToASCII(arr) {
  var item, i, j, row, csv, line, dataline, headerline, max_left_Ritz, max_right_Ritz, parts;
  var header_width;
  csv = [];
  hdr_widths = [];

  // Determine decimal dot position in the Ritz wavelength
  max_left_Ritz = 0;
  max_right_Ritz = 0;
  for (i = 1; i < arr.length; ++i) {
    row = arr[i];
    item = row[0];
    if (item.toString().match(/\./) == null) {
      item = item + ".00";
    }
    parts = item.toString().split(".");
    if ( max_left_Ritz < parts[0].length ) {
      max_left_Ritz = parts[0].length;
    }
    if ( max_right_Ritz < parts[1].length ) {
      max_right_Ritz = parts[1].length;
    }
  }

  // header
  for (i = 0; i < 1; ++i) {
    row = arr[i];
    line = [];
    for (j = 0; j < row.length; ++j) {
      item = row[j];
      if ( (i == 0) && (typeof(item) == 'object') ) {
        item = item.label;
      } else {
        if (item == null) {
          item = '';
        }
      }
      //if ( (i > 0) && (j > 0) && (item != '') && (item != '0') ) {
      //  item = (item - 0).toExponential(3);
      //}
      item = " " + item;
      header_width = item.length;
      if ( (j == 0) && (header_width < (max_left_Ritz + max_right_Ritz + 1)) ) {
        header_width = (max_left_Ritz + max_right_Ritz + 1);
      }
      if (header_width <  11) {  // Sum | Residual |
        header_width = 11;
      }
      hdr_widths[j]=header_width;
      if (j == 0) {  // Ritz wavelength
        item = libs_align_ascii(item,hdr_widths[j],0,0,-2);
      }
      else if ( j == 1) { // Sum
        item = libs_align_ascii(item,hdr_widths[j],0,0,1);
      }
      else {  // e.g. C I ( 6.9e-01)
        item = libs_align_ascii(item,hdr_widths[j],0,0,1);
      }
      line.push(item);
    }
    csv.push(line.join(delimiter));
    headerline = line.join("");
    headerline = headerline + "<br>";
  }

  dataline = "";
  for (i = 1; i < arr.length; ++i) {
    row = arr[i];
    line = [];
    for (j = 0; j < row.length; ++j) {
      item = row[j];
      if ( (i == 0) && (typeof(item) == 'object') ) {
        item = item.label;
      } else {
        if (item == null) {
          item = '';
        }
      }
      if ( (i > 0) && (j > 0) && (item != '') && (item != '0') ) {
        item = (item - 0).toExponential(3);
      }
      item = " "+item;
      if (j == 0) {
        //item = libs_align_ascii(item,hdr_widths[j],17,2,-1);
        item = libs_align_ascii(item,hdr_widths[j],max_left_Ritz,max_right_Ritz,-1);
      }
      else if ( j == 1) { // Sum
        item = libs_align_ascii(item,hdr_widths[j],1,7,0);
      }
      else {
        item = libs_align_ascii(item,hdr_widths[j],1,7,0);
      }
      dataline = dataline + item;
    }
    dataline = dataline + "<br>";
  }
  dataline = headerline + dataline;
  return dataline;
}
