function isNumeric(n) {
  return !isNaN(n) && !isNaN(parseFloat(n)) && isFinite(n);
}
function isNonNegative(n) {
  return isNumeric(n) && (n >= 0);
}

function csv2array(data, delimiter) {
  // Retrieve the delimiter
  if (delimiter == undefined)
    delimiter = ' ';
  if (delimiter && delimiter.length > 1)
    delimiter = ' ';

  // initialize variables
  var newline = '\n';
  var eof = '';
  var i = 0;
  var c = data.charAt(i);
  var row = 0;
  var col = 0;
  var array = new Array();

  while (c != eof) {
    // skip whitespaces
    while (c == ' ' || c == '\t' || c == '\r') {
      c = data.charAt(++i); // read next char
    }

    // get value
    var value = "";
    if (c == '\"') {
      // value enclosed by double-quotes
      c = data.charAt(++i);

      do {
        if (c != '\"') {
          // read a regular character and go to the next character
          value += c;
          c = data.charAt(++i);
        }

        if (c == '\"') {
          // check for escaped double-quote
          var cnext = data.charAt(i+1);
          if (cnext == '\"') {
            // this is an escaped double-quote.
            // Add a double-quote to the value, and move two characters ahead.
            value += '\"';
            i += 2;
            c = data.charAt(i);
          }
        }
      }
      while (c != eof && c != '\"');

      if (c == eof) {
        throw "Unexpected end of data, double-quote expected";
      }

      c = data.charAt(++i);
    }
    else {
      // value without quotes
      while (c != eof && c != delimiter && c!= newline && c != ' ' && c != '\t' && c != '\r') {
        value += c;
        c = data.charAt(++i);
      }
    }

    // add the value to the array
    if (array.length <= row)
      array.push(new Array());
    array[row].push(value);
    //console.log("row="+row+", col="+col+", pushing value="+value);

    // skip whitespaces
    while ( ((c == ' ') && ((delimiter != ' ')) )
        || ((delimiter !='\t') && (c == '\t')) || c == '\r')
    {
      //console.log("row="+row+", col="+col+", skipping char <" + c +"> at i=" + i);
      c = data.charAt(++i);
    }

    // go to the next row or column
    if (c == delimiter) {
      // to the next column
      col++;
    }
    else if (c == newline) {
      // to the next row
      col = 0;
      row++;
    }
    else if (c != eof) {
      // unexpected character
      throw "Delimiter expected after character " + i;
      //console.log("row="+row+", col="+col+", c=<"+c+">"+", cPrev=<"+cPrev+">");
    }

    // go to the next character
    c = data.charAt(++i);
  }
  //for ( var i = 0; i < 10; i++ ) {
    //console.log('i=' + i + ", array[i].length=" + array[i].length + ", [0]=" + array[i][0] + ", [1]=" + array[i][1]);
  //}
  testUserData(array);
  return array;
}
function testUserData(rows) {
  if ( rows.length < 2 ) {
    throw("Error: too few rows in the user file (" + rows.length + ")");
  }
  if ( rows[0].length != 2 ) {
    throw('Error: number of columns in the user file (' +
      rows[0].length + ') differs from 2.');
  }
  return;
}
function convertValues(rows) {
  var hasCommaSep = false;
  var decComma = false;
  //var maxLinesToTest = 100;
  for ( var i in rows ) {
    var row = rows[i];
    for ( var j in row ) {
      if (row[j].match(/,\d\d\d[.]|[.]\d\d\d,/) != null) {
        hasCommaSep = true;
        break;
      }
    }
    if ( hasCommaSep ) {
      break;
    }
  }
  //console.log("hasCommaSep=" + hasCommaSep);
  var re = new RegExp(' ','g');
  if ( hasCommaSep ) {
    re = new RegExp('[ ,]','g');
  }
  for ( var i in rows ) {
    var row = rows[i];
    for ( var j in row ) {
      row[j] = row[j].replace(re,'');
    }
  }
  for ( var i in rows ) {
    var row = rows[i];
    for ( var j in row ) {
      if (row[j].match(/\d+,\d+/) != null) {
        decComma = true;
        break;
      }
    }
    if ( decComma ) {
      break;
    }
  }
  //console.log("decComma=" + decComma);
  if ( decComma ) {
    re = new RegExp('[,]','g');
    for ( var i in rows ) {
      var row = rows[i];
      for ( var j in row ) {
        row[j] = row[j].replace(re,'.');
      }
    }
  }
  return rows;
}
function CSVtoArr(CSV) {
  var rows;
  var delimiter = ' ';
  try {
    //alert("trying <" +delimiter + ">");
    rows = csv2array(CSV, delimiter);
  } catch(e) {
    //alert("After trying <" +delimiter + ">:\n" + e);
    delimiter = ',';
    try {
      //alert("trying <" +delimiter + ">");
      rows = csv2array(CSV, delimiter);
    } catch(e) {
      //alert("After trying <" +delimiter + ">:\n" + e);
      delimiter = '\t';
      try {
        //alert("trying <" +delimiter + ">");
        rows = csv2array(CSV, delimiter);
      } catch(e) {
        //if ( e == null ) {
        //  return ("Error: uncaught exception in file read");
        //}
        //alert("After trying tab:\n" + e);
        if ( e.toString().match(/^Error:/) != null) {
          return e;
        }
        return "Error: unrecognized format of the user file.\n" +
          "It must be a space-, comma-, or tab-delimited ASCII file.\n" +
          "More details: " + e;
      }
    }
  }
  rows = convertValues(rows);
  var arr = [];
  var hash = {};
  var alerts = '';
  for (var i=0; i < rows.length; i++ ) {
    var row = rows[i];
    if ( (row[0] == '') && (row[1] == '') ) {
      alerts += ((alerts ? '\n' : '') + "Blank row " + i + " skipped.");
      continue;
    }
    if ( row[0] == '' ) {
      alerts += ((alerts ? '\n' : '') + "Row " + i + " with blank wavelength skipped.");
      continue;
    }
    if ( row[1] == '' ) {
      alerts += ((alerts ? '\n' : '') + "Row " + i + " with blank intensity skipped.");
      continue;
    }
    if ( row[0] == 0 ) {
      alerts += ((alerts ? '\n' : '') + "Row " + i + " with zero wavelength skipped.");
      continue;
    }
    if ( row[1] == 0 ) {
      alerts += ((alerts ? '\n' : '') + "Row " + i + " with zero intensity skipped.");
      continue;
    }
    if ( (i > 0) || isNumeric(row[0]) ) {
      if ( !isNonNegative(row[0]) || !isNonNegative(row[1]) ) {
        return "Error in row " + i + " of the user file: \n" +
          "All values must be non-negative numbers.\n" +
          "Row content: " + row[0] + delimiter + row[1];
      }
      if ( hash[row[0]] != undefined ) {
        arr[hash[row[0]]] += row[1];
        alerts += ((alerts ? '\n' : '') + "Duplicate wavelength " + row[0] + "; Intensities from rows with duplicate wavelengths ade summed up.");
      } else {
        arr.push(row);
        hash[row[0]] = arr.length - 1;
      }
    }
  }
  if ( arr.length < 2 ) {
    return "Error: too few non-blank data rows in the user file (" + arr.length + ")";
  }
  if ( alerts != '' ) {
    alert(alerts);
  }
  return arr;
}
