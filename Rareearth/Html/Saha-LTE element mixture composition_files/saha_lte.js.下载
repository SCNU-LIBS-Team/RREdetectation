function elementNumber(element,spectra) {
  var z = 0;
  element = upperFirst(element);
  for (var el in spectra) {
    for ( var sc in spectra[el]) {
      var spName = spectra[el][sc].name;
      var spArr = spName.split(/ /);
      var elName = spArr[0];
      if ( elName == element ) {
        return el;
      }
    }
  }
  return z;
}
function makeCompHash(composition,spectra) {
  var compArray = composition.split(/;/);
  var compHash = {};
  for (var i in compArray) {
    var tok = compArray[i];
    var elPcnt = tok.split(/:/);
    var elem = elPcnt[0];
    var pcnt = elPcnt[1];
    var z = elementNumber(elem,spectra);
    if ( z > 0 ) {
      compHash[z] = pcnt;
    }
  }
  return compHash;
}
