}
function interpolate(data,firstCol,calcRes) {
  //console.log("firstCol=" + firstCol + ", typeof(data.length)=" + typeof(data.length));
  if ( typeof(data.length) == "undefined" ) {
    return;
  }
  var numRows = data.length;
  if ( !numRows ) {
    return;
  }
  var numColumns = data[1].length;
  //console.log("numColumns=" + numColumns + ", firstCol=" + firstCol);
  var wlPrev = 0;
  var resPrev = 0;
  var intPrev = 0;
  var sumRes = 0;
  var sumInt = 0;
  var wlFirst = 0;
  var wlLast = 0;
  for ( var k = firstCol; k < numColumns; k++) {
    var start = -1;
    var startInt = null;
    var startWL = null;
    // Skip the first row (i=0): it is reserved for column definitions
    for ( var i = 1; i < numRows; i++) {
      if ( calcRes && (k == (numColumns - 1)) ) {
        // Calculate residual: column 1 is exp, intensity, column 2 is total calc intensity
        if ( (data[i][1] != null) && (data[i][2] != null) ) {
          data[i][k] = (data[i][1] - data[i][2]); //.toExponential(3);
          if ( wlPrev != 0 ) {
            var dWL = data[i][0] - wlPrev;
            sumRes += (data[i][k]*data[i][k] + resPrev*resPrev)/2*dWL;
            sumInt += (data[i][1] + intPrev)/2*dWL;
          }
          wlPrev = data[i][0];
          resPrev = data[i][k];
          intPrev = data[i][1];
          if ( wlFirst == 0 ) {
            wlFirst = wlPrev;
          }
          wlLast = wlPrev;
        }
        continue;
      }
      var currWL = data[i][0] - 0;
      var currI = data[i][k];
      if ( currI != null ) {
        currI -= 0;
        if ( start < 0 ) {
          start = i;
          startInt = currI;
          startWL = currWL;
        } else {
          var jMin = start + 1;
          var jMax = i - 1;
          var factor = (currI - startInt)/(currWL - startWL);
          for ( var j = jMin; j <= jMax; j++ ) {
            data[j][k] = (startInt + factor*(data[j][0] - startWL)); //.toExponential(3)
            //console.log("start="+start+", i="+i + ", currWL=" + currWL + ", startWL="+startWL + ", startInt=" +startInt+
            //  ", currI=" + currI + ", j=" + j + ", newWL=" + data[j][0] + ", newInt=" + data[j][k]);
          }
          start = i;
          startInt = currI;
          startWL = currWL;
        }
      }
    }
  }
  return calcRes ? Math.sqrt(sumRes*(wlLast - wlFirst))/sumInt : 0;
}
